    <string name="about_title">About</string>
    <string name="about_version">Version %1$s · MIT license</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Every photo is processed in memory on this device. The app has no network permission, uploads nothing and keeps only what you save.</string>
    <string name="about_principle_title">How it works</string>
    <string name="about_principle_body">A local inversion is c′ = 255 − c, a per-pixel flip that is fully reversible. The app compares pixel steps along each seam to find the border and channels, then flips the values back.</string>
    <string name="about_limit_title">Limits</string>
    <string name="about_limit_body">Inversion can be restored exactly. Blur, mosaic and painted overlays have destroyed the original pixels — they cannot be restored, and the app will not invent content.</string>
    <string name="about_github">View source</string>
    <string name="about_license_body">MIT License © 2026 whp233</string>
    <string name="about_offline">Works offline · No permissions</string>

