<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.InvRestore" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnPrimary">@color/on_amber</item>
        <item name="colorPrimaryContainer">@color/amber_container</item>
        <item name="colorOnPrimaryContainer">@color/on_amber_container</item>

        <item name="colorSecondary">@color/mint</item>
        <item name="colorOnSecondary">#00201A</item>
        <item name="colorSecondaryContainer">@color/mint_container</item>
        <item name="colorOnSecondaryContainer">@color/on_mint_container</item>

        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/stroke_soft</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">#2A0505</item>

        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="materialButtonStyle">@style/Widget.InvRestore.Button</item>
        <item name="materialCardViewStyle">@style/Widget.InvRestore.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.InvRestore.BottomNav</item>
        <item name="bottomSheetDialogTheme">@style/Theme.InvRestore.Sheet</item>
        <item name="materialAlertDialogTheme">@style/Theme.InvRestore.Dialog</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.InvRestore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ink</item>
        <item name="postSplashScreenTheme">@style/Theme.InvRestore</item>
    </style>

    <!-- 文本 -->
    <style name="TextAppearance.InvRestore.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.InvRestore.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.InvRestore.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.InvRestore.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.InvRestore.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- 按钮 -->
    <style name="Widget.InvRestore.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/amber</item>
        <item name="android:textColor">@color/on_amber</item>
        <item name="iconTint">@color/on_amber</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.InvRestore.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_3</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.InvRestore.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.InvRestore.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="Widget.InvRestore.Button.Text.Accent" parent="Widget.InvRestore.Button.Text">
        <item name="android:textColor">@color/amber</item>
        <item name="iconTint">@color/amber</item>
    </style>

    <style name="Widget.InvRestore.Button.Text.Danger" parent="Widget.InvRestore.Button.Text">
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
    </style>

    <style name="Widget.InvRestore.IconButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingLeft">11dp</item>
        <item name="android:paddingRight">11dp</item>
        <item name="rippleColor">@color/stroke</item>
    </style>

    <!-- 卡片 -->
    <style name="Widget.InvRestore.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/stroke</item>
    </style>

    <style name="Widget.InvRestore.Card.Flat">
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 底部导航 -->
    <style name="Widget.InvRestore.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_1</item>
        <item name="backgroundTint">@color/surface_1</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.InvRestore.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.InvRestore.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.InvRestore.BottomNav.Inactive</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="minHeight">64dp</item>
    </style>

    <style name="Widget.InvRestore.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/amber_container</item>
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
    </style>

    <style name="TextAppearance.InvRestore.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.InvRestore.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.InvRestore.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="iconTint">@color/segment_text</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <!-- 弹层 -->
    <style name="Theme.InvRestore.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.InvRestore.Sheet</item>
    </style>

    <style name="Widget.InvRestore.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_2</item>
        <item name="shapeAppearance">@style/ShapeAppearance.InvRestore.Sheet</item>
    </style>

    <style name="ShapeAppearance.InvRestore.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.InvRestore.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorSurface">@color/surface_2</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Widget.InvRestore.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
